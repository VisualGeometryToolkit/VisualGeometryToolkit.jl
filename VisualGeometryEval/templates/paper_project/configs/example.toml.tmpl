# The config of record of scripts/example_stage.jl: every value its results
# depend on. Its run key (the SHA-256 of this table, [render] excluded) names
# the results directory, so a changed value is a new run, never an overwrite.

[simulate]
seed = 1
n = 40
x_min = 0.0
x_max = 1.0
slope = 2.0
intercept = 0.5
noise = 0.1

# Excluded from the run key (Experiments RUN_KEY_EXCLUDED): what the paper
# shows, not what was computed.
[render]
figure = "example_fit.tex"
caption = "example_fit_caption.tex"
macros = "example_numbers.tex"
digits = 2
