#!/usr/bin/env julia
# provenance: every product writes _config.toml and _provenance.toml (produce) beside its results.
# =============================================================================
# scripts/example_stage.jl — the worked example of a paper-project driver: one
# file per paper asset, its config of record in configs/, its results in
# DrWatson's datadir("exp_pro") as keyed products (produce: produce_or_load,
# each keyed by only what it reads), their provenance beside them, its
# assets rendered under plots/ and deployed into the paper (Reproduce
# deploy_assets: a changed submitted asset needs sign-off). Replace it with the
# project's own drivers.
#
# reproduce: reads configs/example.toml
# reproduce: writes {{FIGDIR}}/example_fit.tex
# reproduce: writes {{FIGDIR}}/example_fit_caption.tex
# reproduce: writes {{FIGDIR}}/example_numbers.tex
#
# STAGES (each product keyed by only what it reads: <results>/example/<product>/<key>/, DrWatson's datadir("exp_pro", …))
#   simulate  the samples [simulate] states → simulate/<key>/samples.tsv
#   fit       the least-squares line through them → fit/<key>/fit.toml (keyed by the samples' product)
#   figure    the samples and the line as a pgfplots panel + its caption snippet and the numbers the prose quotes
#             (Reproduce: write_numbers) → figure/<key>/ (keyed by [render] and the fit's product), published to plots/example/
#   deploy    the renders into the paper: a new asset is copied, a changed one only with --replace-submitted
#
#   julia --project=. scripts/example_stage.jl [--plan] [--stage=NAME] [--force] [--replace-submitted] [--results-branch]
#
# --results-branch: a full reproduction for review. The stages run but deploy; this run's
# renders become a branch results/<UTC stamp>-<commit> of the paper's repository, in a
# worktree of its own, with RUN.toml and COMPARISON.md against the paper as committed
# (Reproduce results_branch; README.md). The paper itself is not touched.
# =============================================================================
using DrWatson
@quickactivate "{{NAME}}"
include(srcdir("{{NAME}}.jl"))

const CFG_PATH = projectdir("configs", "example.toml")
const CFG = TOML.parsefile(CFG_PATH)
const RECORDS = (; driver = "example_stage.jl", config_source = CFG_PATH)    # every product's records name the driver and the config
# the products, each keyed by only what it reads; [render] keys the figure alone (under its own name: the config's [render] is
# excluded from a whole config's key, here it is the figure's input). Built when their stage runs: a consumer's key folds its
# upstream's output as produced (a re-simulated sample set re-keys the fit and the figure)
simulate_product() = Product("example", "simulate", Dict("simulate" => CFG["simulate"]); output = "samples.tsv")
fit_product() = Product("example", "fit", Dict{String, Any}(); output = "fit.toml", upstream = ("simulate" => simulate_product(),))
figure_product() = Product("example", "figure", Dict("panel" => CFG["render"]); output = CFG["render"]["macros"],
                           upstream = ("fit" => fit_product(),))
const SAMPLES = product_output(simulate_product())
const RENDERS = plotsdir("example")            # the renders; the deploy stage puts them into the paper
const PAPER_FIGURES = paper_figures_dir(PAPER)        # figures/ beside the paper (PaperProjects)
const ASSETS = [CFG["render"][k] for k in ("figure", "caption", "macros")]
const RESULTS_BRANCH = "--results-branch" in ARGS

function simulate(dir)
    s = CFG["simulate"]
    rng = StableRNG(s["seed"])
    x = collect(range(s["x_min"], s["x_max"]; length = s["n"]))
    y = s["slope"] .* x .+ s["intercept"] .+ s["noise"] .* randn(rng, length(x))
    open(joinpath(dir, "samples.tsv"), "w") do io
        println(io, "x\ty")
        foreach((a, b) -> println(io, a, '\t', b), x, y)
    end
    return nothing
end

read_samples() = (rows = split.(readlines(SAMPLES)[2:end], '\t');
                  (parse.(Float64, first.(rows)), parse.(Float64, last.(rows))))

function fit(dir)
    require_input(SAMPLES; what = "the example samples", provenance = "stage simulate of this file")
    x, y = read_samples()
    x̄, ȳ = sum(x) / length(x), sum(y) / length(y)
    slope = sum((x .- x̄) .* (y .- ȳ)) / sum((x .- x̄) .^ 2)
    open(joinpath(dir, "fit.toml"), "w") do io
        TOML.print(io, Dict("slope" => slope, "intercept" => ȳ - slope * x̄, "n" => length(x)))
    end
    return nothing
end

# the panel, its caption and the numbers, written into the figure product's directory
function figure(dir, product)
    x, y = read_samples()
    fitted = fit_product()
    f = TOML.parsefile(product_output(fitted))
    lo, hi = extrema(x)
    open(joinpath(dir, CFG["render"]["figure"]), "w") do io
        println(io, "% generated by scripts/example_stage.jl (product ", product.key, "); do not edit")
        println(io, "\\begin{tikzpicture}\\begin{axis}[", HOUSE_AXIS_COMMON, ", width=0.8\\linewidth, height=5cm, xlabel={\$x\$}, ylabel={\$y\$}]")
        println(io, "\\addplot[only marks, mark size=", HOUSE_MARK_SIZE, "] coordinates {",
                join(("($a,$b)" for (a, b) in zip(x, y)), " "), "};")
        println(io, "\\addplot[", HOUSE_LINE_WIDTH, ", domain=$lo:$hi] {", f["slope"], "*x + ", f["intercept"], "};")
        println(io, "\\end{axis}\\end{tikzpicture}")
    end
    write(joinpath(dir, CFG["render"]["caption"]), "\\caption{The example samples and their least-squares line (slope \\ExampleSlope).}\n")
    prov = read_provenance(product_dir(fitted))
    haskey(prov, "gitcommit") || error("$(product_dir(fitted)) records no commit: run the stages inside the project's git checkout")
    nums = PaperNumbers(; driver = relpath(@__FILE__, projectdir()), config = relpath(CFG_PATH, projectdir()),
                        run_key = product.key, commit = prov["gitcommit"])
    # `better`: the direction in which a number improves (:lower, :higher, :none), for a results
    # branch's comparison; a fitted slope and a sample count improve in neither
    add_number!(nums, "ExampleSlope", f["slope"]; digits = CFG["render"]["digits"], better = :none)
    add_number!(nums, "ExampleN", f["n"]; better = :none)
    write_numbers(joinpath(dir, CFG["render"]["macros"]), nums)       # the product's output: written last
    return nothing
end

# the figure product produced (or loaded), its assets published to plots/ (a final output, DrWatson's plotsdir)
function publish(product)
    produce(d -> figure(d, product), product; RECORDS...)
    mkpath(RENDERS)
    foreach(a -> cp(joinpath(product_dir(product), a), joinpath(RENDERS, a); force = true), ASSETS)
    return nothing
end

const STAGES = [
    Stage(:simulate, "the samples of [simulate]"; items = () -> [simulate_product()], product = identity, run = p -> produce(simulate, p; RECORDS...)),
    Stage(:fit, "the least-squares line"; items = () -> [fit_product()], product = identity, run = p -> produce(fit, p; RECORDS..., inputs = [SAMPLES])),
    Stage(:figure, "the panel, its caption and the numbers the prose quotes"; items = () -> [figure_product()], product = identity, run = publish),
    Stage(:deploy, "the renders into the paper (a changed submitted asset needs --replace-submitted)";
          check = () -> deploy_assets(RENDERS, PAPER_FIGURES, ASSETS; replace_submitted = "--replace-submitted" in ARGS)),
]

run_stages("example_stage", RESULTS_BRANCH ? filter(st -> st.name != :deploy, STAGES) : STAGES)

# A full reproduction for review: this run's renders on a results branch, never on the paper's own
# branch, compared with the paper as committed; the data tier is the synthetic draws the fit, the
# figure and the numbers read. accept_results brings them in, remove_results_worktree removes the worktree.
if RESULTS_BRANCH && !("--plan" in ARGS)
    results_branch(projectdir(), [joinpath(RENDERS, a) => relpath(joinpath(PAPER_FIGURES, a), projectdir()) for a in ASSETS];
                   run_keys = [simulate_product().key], tiers = ["example_samples" => SAMPLES])
end
