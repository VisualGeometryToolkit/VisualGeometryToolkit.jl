#!/usr/bin/env julia
# provenance: every run writes _config.toml and _provenance.toml (write_run_records) beside its results.
# =============================================================================
# scripts/example_stage.jl — the worked example of a paper-project driver: one
# file per paper asset, its config of record in configs/, its results in a
# directory keyed by that config's run key, its provenance beside them, its
# assets rendered under plots/ and deployed into the paper (Reproduce
# deploy_assets: a changed submitted asset needs sign-off). Replace it with the
# project's own drivers.
#
# reproduce: reads configs/example.toml
# reproduce: writes {{FIGDIR}}/example_fit.tex
# reproduce: writes {{FIGDIR}}/example_fit_caption.tex
# reproduce: writes {{FIGDIR}}/example_numbers.tex
#
# STAGES
#   simulate  the samples [simulate] states → <results>/example/example-<run key>/samples.tsv
#   fit       the least-squares line through them → fit.toml beside them
#   figure    the samples and the line as a pgfplots panel + its caption snippet, under plots/example/
#   macros    the numbers the prose quotes, as \newcommand lines (Reproduce: write_numbers), beside them
#   deploy    the renders into the paper: a new asset is copied, a changed one only with --replace-submitted
#
#   julia --project=. scripts/example_stage.jl [--plan] [--stage=NAME] [--force] [--replace-submitted] [--results-branch]
#
# --results-branch: a full reproduction for review. The stages run but deploy; this run's
# renders become a branch results/<UTC stamp>-<commit> of the paper's repository, in a
# worktree of its own, with RUN.toml and COMPARISON.md against the paper as committed
# (Reproduce results_branch; README.md). The paper itself is not touched.
# =============================================================================
using DrWatson
@quickactivate "{{NAME}}"
include(srcdir("{{NAME}}.jl"))

const CFG_PATH = projectdir("configs", "example.toml")
const CFG = TOML.parsefile(CFG_PATH)
const KEY = run_key(CFG)                      # [render] is excluded: a cosmetic edit never re-keys
const OUTDIR = joinpath(results_root(), "example", "example-" * KEY)
const SAMPLES = joinpath(OUTDIR, "samples.tsv")
const FIT = joinpath(OUTDIR, "fit.toml")
const RENDERS = plotsdir("example")            # the renders; the deploy stage puts them into the paper
const PAPER_FIGURES = projectdir({{FIGDIR_ARGS}})
const ASSETS = [CFG["render"][k] for k in ("figure", "caption", "macros")]
const FIGURE = joinpath(RENDERS, CFG["render"]["figure"])
const CAPTION = joinpath(RENDERS, CFG["render"]["caption"])
const MACROS = joinpath(RENDERS, CFG["render"]["macros"])
const RESULTS_BRANCH = "--results-branch" in ARGS

function simulate()
    s = CFG["simulate"]
    rng = StableRNG(s["seed"])
    x = collect(range(s["x_min"], s["x_max"]; length = s["n"]))
    y = s["slope"] .* x .+ s["intercept"] .+ s["noise"] .* randn(rng, length(x))
    mkpath(OUTDIR)
    open(SAMPLES, "w") do io
        println(io, "x\ty")
        foreach((a, b) -> println(io, a, '\t', b), x, y)
    end
    write_run_records(OUTDIR, CFG; driver = "example_stage.jl", config_source = CFG_PATH, key = KEY)
    return nothing
end

read_samples() = (rows = split.(readlines(SAMPLES)[2:end], '\t');
                  (parse.(Float64, first.(rows)), parse.(Float64, last.(rows))))

function fit()
    require_input(SAMPLES; what = "the example samples", provenance = "stage simulate of this file")
    x, y = read_samples()
    x̄, ȳ = sum(x) / length(x), sum(y) / length(y)
    slope = sum((x .- x̄) .* (y .- ȳ)) / sum((x .- x̄) .^ 2)
    open(FIT, "w") do io
        TOML.print(io, Dict("slope" => slope, "intercept" => ȳ - slope * x̄, "n" => length(x)))
    end
    return nothing
end

function figure()
    x, y = read_samples()
    f = TOML.parsefile(FIT)
    lo, hi = extrema(x)
    mkpath(dirname(FIGURE))
    open(FIGURE, "w") do io
        println(io, "% generated by scripts/example_stage.jl (run ", KEY, "); do not edit")
        println(io, "\\begin{tikzpicture}\\begin{axis}[", HOUSE_AXIS_COMMON, ", width=0.8\\linewidth, height=5cm, xlabel={\$x\$}, ylabel={\$y\$}]")
        println(io, "\\addplot[only marks, mark size=", HOUSE_MARK_SIZE, "] coordinates {",
                join(("($a,$b)" for (a, b) in zip(x, y)), " "), "};")
        println(io, "\\addplot[", HOUSE_LINE_WIDTH, ", domain=$lo:$hi] {", f["slope"], "*x + ", f["intercept"], "};")
        println(io, "\\end{axis}\\end{tikzpicture}")
    end
    write(CAPTION, "\\caption{The example samples and their least-squares line (slope \\ExampleSlope).}\n")
    return nothing
end

function macros()
    f = TOML.parsefile(FIT)
    prov = read_provenance(OUTDIR)
    haskey(prov, "gitcommit") || error("$OUTDIR records no commit: run the stages inside the project's git checkout")
    nums = PaperNumbers(; driver = relpath(@__FILE__, projectdir()), config = relpath(CFG_PATH, projectdir()),
                        run_key = KEY, commit = prov["gitcommit"])
    # `better`: the direction in which a number improves (:lower, :higher, :none), for a results
    # branch's comparison; a fitted slope and a sample count improve in neither
    add_number!(nums, "ExampleSlope", f["slope"]; digits = CFG["render"]["digits"], better = :none)
    add_number!(nums, "ExampleN", f["n"]; better = :none)
    write_numbers(MACROS, nums)
    return nothing
end

const STAGES = [
    Stage(:simulate, "the samples of [simulate], keyed by the run key", () -> run_complete(OUTDIR; sidecar = "samples.tsv"), simulate),
    Stage(:fit, "the least-squares line", () -> fresher(FIT, SAMPLES), fit),
    Stage(:figure, "the panel and its caption", () -> fresher(FIGURE, FIT, CFG_PATH) && isfile(CAPTION), figure),
    Stage(:macros, "the numbers the prose quotes", () -> fresher(MACROS, FIT, CFG_PATH), macros),
    Stage(:deploy, "the renders into the paper (a changed submitted asset needs --replace-submitted)",
          () -> assets_deployed(RENDERS, PAPER_FIGURES, ASSETS),
          () -> deploy_assets(RENDERS, PAPER_FIGURES, ASSETS; replace_submitted = "--replace-submitted" in ARGS)),
]

run_stages("example_stage", RESULTS_BRANCH ? filter(st -> st.name != :deploy, STAGES) : STAGES)

# A full reproduction for review: this run's renders on a results branch, never on the paper's own
# branch, compared with the paper as committed; the data tier is the synthetic draws the fit, the
# figure and the numbers read. accept_results brings them in, remove_results_worktree removes the worktree.
if RESULTS_BRANCH && !("--plan" in ARGS)
    results_branch(projectdir(), [joinpath(RENDERS, a) => relpath(joinpath(PAPER_FIGURES, a), projectdir()) for a in ASSETS];
                   run_keys = [KEY], tiers = ["example_samples" => SAMPLES])
end
