#!/usr/bin/env julia
# =============================================================================
# scripts/fetch_data.jl — the new-machine setup step: the published inputs of
# {{NAME}} (configs/data_artifacts.toml, bound in Artifacts.toml) installed into
# the artifact store (VisualGeometryToolkitCore's `artifact_store`:
# VGTK_ARTIFACT_STORE, the site profile VGTK_SITE names, the preference, the
# depot — refused on a cluster) and linked into data/exp_raw, the artifact view
# the drivers read through data_root(). Every paper project has this script
# (paper_project_violations, L5): it is the one way its data reach a machine.
#
#   julia --project=. scripts/fetch_data.jl              # the required artifacts
#   julia --project=. scripts/fetch_data.jl --all        # every catalogued artifact
#   julia --project=. scripts/fetch_data.jl --only=a,b   # the named ones
#   julia --project=. scripts/fetch_data.jl --list       # the catalog, nothing fetched
# =============================================================================
using DrWatson
@quickactivate
using VisualGeometryToolkitEval.DataArtifacts: fetch_data!, project_catalog

fetch_data!(project_catalog())
