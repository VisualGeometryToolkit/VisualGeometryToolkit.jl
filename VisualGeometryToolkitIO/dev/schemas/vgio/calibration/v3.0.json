{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://visualgeometrytoolkit.github.io/schemas/vgio/calibration/v3.0.json",
    "title": "vgio/calibration/v3.0",
    "description": "A vgio/calibration/v3.0 file, as VisualGeometryToolkitIO writes and reads it; generated from its validator (VisualGeometryToolkitIO.json_schema). The validator is the authority: a check stated only in a `description` is the reader's. A file of a higher minor version of this major may hold keys this version does not declare: validate it against its own version's schema. a `model`'s intrinsics are the `result_kind`'s (metric or projective); an \"image\" result lists no trajectory or target_poses record",
    "type": "object",
    "properties": {
        "schema": {
            "type": "string",
            "description": "vgio/calibration/v3.0, or the same major version at any minor",
            "pattern": "^vgio/calibration/v3(\\.[0-9]+)?$"
        },
        "generator": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "description": "a version number"
                },
                "caller": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string",
                            "minLength": 1
                        },
                        "version": {
                            "type": "string",
                            "description": "a version number"
                        }
                    },
                    "required": [
                        "name",
                        "version"
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "name",
                "version"
            ],
            "additionalProperties": false
        },
        "units": {
            "type": "object",
            "properties": {
                "length": {
                    "type": "string",
                    "description": "a registered length unit (mm, cm, m, um, inch)",
                    "enum": [
                        "cm",
                        "ft",
                        "in",
                        "inch",
                        "km",
                        "m",
                        "mm",
                        "pt",
                        "um",
                        "μm"
                    ]
                },
                "time": {
                    "const": "s"
                },
                "angle": {
                    "const": "rad"
                },
                "pixel": {
                    "type": "string",
                    "description": "a registered pixel frame (colmap, opencv, julia)",
                    "enum": [
                        "colmap",
                        "julia",
                        "opencv"
                    ]
                },
                "density": {
                    "type": "string",
                    "description": "a registered density unit (dpi)",
                    "enum": [
                        "dpi"
                    ]
                },
                "radiance": {
                    "const": "relative"
                },
                "length_roles": {
                    "type": "object",
                    "description": "length role → its length unit, for the fields whose lengths are not in `length`; \"chart\": a chart role, its numbers a chart's (plain)",
                    "propertyNames": {
                        "pattern": "^[a-z][a-z0-9_]*$",
                        "not": {
                            "enum": [
                                "length",
                                "world",
                                "density"
                            ]
                        }
                    },
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "string",
                                "description": "a registered length unit (mm, cm, m, um, inch)",
                                "enum": [
                                    "cm",
                                    "ft",
                                    "in",
                                    "inch",
                                    "km",
                                    "m",
                                    "mm",
                                    "pt",
                                    "um",
                                    "μm"
                                ]
                            },
                            {
                                "const": "chart"
                            }
                        ]
                    }
                }
            },
            "required": [
                "length",
                "time",
                "angle",
                "pixel",
                "density",
                "radiance",
                "length_roles"
            ],
            "additionalProperties": false
        },
        "conventions": {
            "type": "object",
            "properties": {
                "rotation_encoding": {
                    "const": "quaternion_wxyz_hamilton"
                },
                "transform_convention": {
                    "const": "x_to = R * x_from + t"
                },
                "matrix_layout": {
                    "const": "rows"
                },
                "grid_layout": {
                    "const": "row_major"
                },
                "index_base": {
                    "const": 1
                }
            },
            "required": [
                "rotation_encoding",
                "transform_convention",
                "matrix_layout",
                "grid_layout",
                "index_base"
            ],
            "additionalProperties": false
        },
        "result_kind": {
            "type": "string",
            "description": "a calibration result kind (metric, projective, image)",
            "enum": [
                "metric",
                "projective",
                "image"
            ]
        },
        "files": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "description": "a relative path inside the manifest's directory"
                    },
                    "sha256": {
                        "type": "string",
                        "description": "a SHA-256 hex digest (64 lowercase hex digits)",
                        "pattern": "^[0-9a-f]{64}$"
                    },
                    "schema": {
                        "type": "string",
                        "description": "a record schema (`<owner>/<kind>/v<major>[.<minor>]`)",
                        "pattern": "^([a-z][a-z0-9_]*)/([a-z0-9_]+)/v(\\d+)(?:\\.(\\d+))?$"
                    },
                    "role": {
                        "type": "string",
                        "description": "a role (authority, derived)",
                        "enum": [
                            "authority",
                            "derived"
                        ]
                    },
                    "derived_from": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "required": [
                    "path",
                    "sha256",
                    "schema",
                    "role",
                    "derived_from"
                ],
                "additionalProperties": false,
                "description": "an authority is derived from nothing; a derived file names at least one file it is derived from, never itself",
                "allOf": [
                    {
                        "else": {
                            "properties": {
                                "derived_from": {
                                    "minItems": 1
                                }
                            }
                        },
                        "if": {
                            "properties": {
                                "role": {
                                    "const": "authority"
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "derived_from": {
                                    "maxItems": 0
                                }
                            }
                        }
                    }
                ]
            },
            "description": "at least one file; paths unique (after normalization); every `derived_from` names a listed path, and no file is derived from itself through `derived_from`",
            "allOf": [
                {
                    "minItems": 1
                }
            ]
        },
        "model": {
            "type": "object",
            "description": "VisualGeometryToolkitCore's `CameraModelSpec` record, read by its reader"
        },
        "metrics": {
            "type": "object",
            "additionalProperties": {
                "type": "number"
            }
        },
        "provenance": {
            "type": "object"
        }
    },
    "required": [
        "schema",
        "generator",
        "units",
        "conventions",
        "result_kind",
        "files"
    ],
    "additionalProperties": false
}