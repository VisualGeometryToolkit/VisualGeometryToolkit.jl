                        "enum": [
                            "dpi"
                        ]
                    },
                    "radiance": {
                        "const": "relative"
                    },
                    "length_roles": {
                        "type": "object",
                        "description": "length role → its length unit, for the fields whose lengths are not in `length`",
                        "propertyNames": {
                            "pattern": "^[a-z][a-z0-9_]*$",
                            "not": {
                                "enum": [
                                    "length",
                                    "world",
                                    "density"
                                ]
                            }
                        },
                        "additionalProperties": {
                            "type": "string",
                            "description": "a registered length unit (mm, cm, m, um, inch)",
                            "enum": [
