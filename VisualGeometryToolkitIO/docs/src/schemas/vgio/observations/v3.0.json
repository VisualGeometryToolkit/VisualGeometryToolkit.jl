            "conventions": {
                "type": "object",
                "properties": {
                    "rotation_encoding": {
                        "const": "quaternion_wxyz_hamilton"
                    },
                    "transform_convention": {
                        "const": "x_to = R * x_from + t"
                    },
                    "matrix_layout": {
                        "const": "rows"
                    },
                    "grid_layout": {
                        "const": "row_major"
                    },
                    "index_base": {
                        "const": 1
                    }
