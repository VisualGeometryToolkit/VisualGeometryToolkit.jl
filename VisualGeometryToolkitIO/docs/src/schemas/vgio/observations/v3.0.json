                    "angle": {
                        "const": "rad"
                    },
                    "pixel": {
                        "type": "string",
                        "description": "a registered pixel frame (colmap, opencv, julia)",
                        "enum": [
                            "colmap",
                            "julia",
                            "opencv"
                        ]
                    },
                    "density": {
                        "type": "string",
