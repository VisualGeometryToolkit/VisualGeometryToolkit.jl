{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://visualgeometrytoolkit.github.io/schemas/vgio/observations/v3.0.json",
    "title": "vgio/observations/v3.0",
    "description": "A vgio/observations/v3.0 file, as VisualGeometryToolkitIO writes and reads it; generated from its validator (VisualGeometryToolkitIO.json_schema). The validator is the authority: a check stated only in a `description` is the reader's. A file of a higher minor version of this major may hold keys this version does not declare: validate it against its own version's schema.",
    "if": {
        "required": [
            "frame"
        ]
    },
    "then": {
        "type": "object",
        "properties": {
            "schema": {
                "type": "string",
                "description": "vgio/observations/v3.0, or the same major version at any minor",
                "pattern": "^vgio/observations/v3(\\.[0-9]+)?$"
            },
            "generator": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "version": {
                        "type": "string",
                        "description": "a version number"
                    },
                    "caller": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "version": {
                                "type": "string",
                                "description": "a version number"
                            }
                        },
                        "required": [
                            "name",
                            "version"
                        ],
                        "additionalProperties": false
                    }
                },
                "required": [
                    "name",
                    "version"
                ],
                "additionalProperties": false
            },
            "units": {
                "type": "object",
                "properties": {
                    "length": {
                        "type": "string",
                        "description": "a registered length unit (mm, cm, m, um, inch)",
                        "enum": [
                            "cm",
                            "ft",
                            "in",
                            "inch",
                            "km",
                            "m",
                            "mm",
                            "pt",
                            "um",
                            "μm"
                        ]
                    },
                    "time": {
                        "const": "s"
