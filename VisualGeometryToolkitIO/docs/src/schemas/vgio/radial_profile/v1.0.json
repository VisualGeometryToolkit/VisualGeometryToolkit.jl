{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://visualgeometrytoolkit.github.io/schemas/vgio/radial_profile/v1.0.json",
    "title": "vgio/radial_profile/v1.0",
    "description": "A vgio/radial_profile/v1.0 file, as VisualGeometryToolkitIO writes and reads it; generated from its validator (VisualGeometryToolkitIO.json_schema). The validator is the authority: a check stated only in a `description` is the reader's. A file of a higher minor version of this major may hold keys this version does not declare: validate it against its own version's schema.",
    "type": "object",
    "properties": {
        "schema": {
            "type": "string",
            "description": "vgio/radial_profile/v1.0, or the same major version at any minor",
            "pattern": "^vgio/radial_profile/v1(\\.[0-9]+)?$"
        },
        "generator": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "description": "a version number"
                },
                "caller": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string",
                            "minLength": 1
                        },
                        "version": {
                            "type": "string",
                            "description": "a version number"
                        }
                    },
                    "required": [
                        "name",
                        "version"
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "name",
                "version"
            ],
            "additionalProperties": false
        },
        "units": {
            "type": "object",
            "properties": {
                "length": {
                    "type": "string",
                    "description": "a registered length unit (mm, cm, m, um, inch)",
                    "enum": [
                        "cm",
                        "ft",
                        "in",
                        "inch",
                        "km",
                        "m",
                        "mm",
                        "pt",
                        "um",
                        "μm"
                    ]
                },
                "time": {
                    "const": "s"
                },
                "angle": {
                    "const": "rad"
                },
                "pixel": {
                    "type": "string",
                    "description": "a registered pixel frame (colmap, opencv, julia)",
                    "enum": [
                        "colmap",
                        "julia",
                        "opencv"
                    ]
                },
                "density": {
                    "type": "string",
                    "description": "a registered density unit (dpi)",
                    "enum": [
                        "dpi"
                    ]
                },
                "radiance": {
                    "const": "relative"
                },
                "length_roles": {
                    "type": "object",
                    "description": "length role → its length unit, for the fields whose lengths are not in `length`; \"chart\": a chart role, its numbers a chart's (plain)",
                    "propertyNames": {
                        "pattern": "^[a-z][a-z0-9_]*$",
                        "not": {
                            "enum": [
                                "length",
                                "world",
                                "density"
                            ]
                        }
                    },
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "string",
                                "description": "a registered length unit (mm, cm, m, um, inch)",
                                "enum": [
                                    "cm",
                                    "ft",
                                    "in",
                                    "inch",
                                    "km",
                                    "m",
                                    "mm",
                                    "pt",
                                    "um",
                                    "μm"
                                ]
                            },
                            {
                                "const": "chart"
                            }
                        ]
                    }
                }
            },
            "required": [
                "length",
                "time",
                "angle",
                "pixel",
                "density",
                "radiance",
                "length_roles"
            ],
            "additionalProperties": false
        },
        "conventions": {
            "type": "object",
            "properties": {
                "rotation_encoding": {
                    "const": "quaternion_wxyz_hamilton"
                },
                "transform_convention": {
                    "const": "x_to = R * x_from + t"
                },
                "matrix_layout": {
                    "const": "rows"
                },
                "grid_layout": {
                    "const": "row_major"
                },
                "index_base": {
                    "const": 1
                }
            },
            "required": [
                "rotation_encoding",
                "transform_convention",
                "matrix_layout",
                "grid_layout",
                "index_base"
            ],
            "additionalProperties": false
        },
        "profile": {
            "type": "object",
            "properties": {
                "type": {
                    "const": "binned_radial_profile"
                },
                "chart": {
                    "if": {
                        "required": [
                            "focal_length"
                        ]
                    },
                    "then": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "description": "the equisolid chart (the one that states a focal length)",
                                "const": "equisolid"
                            },
                            "center": {
                                "type": "array",
                                "items": {
                                    "type": "number"
                                },
                                "minItems": 2,
                                "maxItems": 2
                            },
                            "radius": {
                                "type": "number"
                            },
                            "focal_length": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "type",
                            "center",
                            "radius",
                            "focal_length"
                        ],
                        "additionalProperties": false
                    },
                    "else": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "description": "a radial chart (linear, projective, equisolid)",
                                "enum": [
                                    "linear",
                                    "projective",
                                    "equisolid"
                                ]
                            },
                            "center": {
                                "type": "array",
                                "items": {
                                    "type": "number"
                                },
                                "minItems": 2,
                                "maxItems": 2
                            },
                            "radius": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "type",
                            "center",
                            "radius"
                        ],
                        "additionalProperties": false
                    }
                },
                "edges": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "values": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        }
                    }
                },
                "counts": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                }
            },
            "required": [
                "type",
                "chart",
                "edges",
                "values",
                "counts"
            ],
            "additionalProperties": false,
            "description": "B + 1 strictly increasing edges (B ≥ 1); `values` one row per channel (at least one), B values each; `counts` B counts, each ≥ 0; the equisolid chart states its focal length, and only it",
            "allOf": [
                {
                    "properties": {
                        "chart": {
                            "if": {
                                "properties": {
                                    "type": {
                                        "const": "equisolid"
                                    }
                                }
                            },
                            "then": {
                                "required": [
                                    "focal_length"
                                ]
                            }
                        },
                        "counts": {
                            "items": {
                                "minimum": 0
                            }
                        },
                        "edges": {
                            "minItems": 2
                        },
                        "values": {
                            "minItems": 1
                        }
                    }
                }
            ]
        },
        "provenance": {
            "type": "object"
        }
    },
    "required": [
        "schema",
        "generator",
        "units",
        "conventions",
        "profile"
    ],
    "additionalProperties": false
}