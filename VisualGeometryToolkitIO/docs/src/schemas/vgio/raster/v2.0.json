{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://visualgeometrytoolkit.github.io/schemas/vgio/raster/v2.0.json",
    "title": "vgio/raster/v2.0",
    "description": "A vgio/raster/v2.0 file, as VisualGeometryToolkitIO writes and reads it; generated from its validator (VisualGeometryToolkitIO.json_schema). The validator is the authority: a check stated only in a `description` is the reader's. A file of a higher minor version of this major may hold keys this version does not declare: validate it against its own version's schema. a uint8 raster's nan is \"none\"",
    "type": "object",
    "properties": {
        "schema": {
            "type": "string",
            "description": "vgio/raster/v2.0, or the same major version at any minor",
            "pattern": "^vgio/raster/v2(\\.[0-9]+)?$"
        },
        "generator": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "description": "a version number"
                },
                "caller": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string",
                            "minLength": 1
                        },
                        "version": {
                            "type": "string",
                            "description": "a version number"
                        }
                    },
                    "required": [
                        "name",
                        "version"
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "name",
                "version"
            ],
            "additionalProperties": false
        },
        "units": {
            "type": "object",
            "properties": {
                "length": {
                    "type": "string",
                    "description": "a registered length unit (mm, cm, m, um, inch)",
                    "enum": [
                        "cm",
                        "ft",
                        "in",
                        "inch",
                        "km",
                        "m",
                        "mm",
                        "pt",
                        "um",
                        "μm"
                    ]
                },
                "time": {
                    "const": "s"
                },
                "angle": {
                    "const": "rad"
                },
                "pixel": {
                    "type": "string",
                    "description": "a registered pixel frame (colmap, opencv, julia)",
                    "enum": [
                        "colmap",
                        "julia",
                        "opencv"
                    ]
                },
                "density": {
                    "type": "string",
                    "description": "a registered density unit (dpi)",
                    "enum": [
                        "dpi"
                    ]
                },
                "radiance": {
                    "const": "relative"
                },
                "length_roles": {
                    "type": "object",
                    "description": "length role → its length unit, for the fields whose lengths are not in `length`; \"chart\": a chart role, its numbers a chart's (plain)",
                    "propertyNames": {
                        "pattern": "^[a-z][a-z0-9_]*$",
                        "not": {
                            "enum": [
                                "length",
                                "world",
                                "density"
                            ]
                        }
                    },
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "string",
                                "description": "a registered length unit (mm, cm, m, um, inch)",
                                "enum": [
                                    "cm",
                                    "ft",
                                    "in",
                                    "inch",
                                    "km",
                                    "m",
                                    "mm",
                                    "pt",
                                    "um",
                                    "μm"
                                ]
                            },
                            {
                                "const": "chart"
                            }
                        ]
                    }
                }
            },
            "required": [
                "length",
                "time",
                "angle",
                "pixel",
                "density",
                "radiance",
                "length_roles"
            ],
            "additionalProperties": false
        },
        "conventions": {
            "type": "object",
            "properties": {
                "rotation_encoding": {
                    "const": "quaternion_wxyz_hamilton"
                },
                "transform_convention": {
                    "const": "x_to = R * x_from + t"
                },
                "matrix_layout": {
                    "const": "rows"
                },
                "grid_layout": {
                    "const": "row_major"
                },
                "index_base": {
                    "const": 1
                }
            },
            "required": [
                "rotation_encoding",
                "transform_convention",
                "matrix_layout",
                "grid_layout",
                "index_base"
            ],
            "additionalProperties": false
        },
        "size": {
            "type": "object",
            "properties": {
                "width": {
                    "type": "integer",
                    "minimum": 1
                },
                "height": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "required": [
                "width",
                "height"
            ],
            "additionalProperties": false
        },
        "element_type": {
            "type": "string",
            "description": "an element type (float32, uint8)",
            "enum": [
                "float32",
                "uint8"
            ]
        },
        "frame": {
            "if": {
                "required": [
                    "area"
                ]
            },
            "then": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "description": "a chart, page or texture",
                        "enum": [
                            "page",
                            "texture"
                        ]
                    },
                    "area": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        },
                        "minItems": 4,
                        "maxItems": 4
                    }
                },
                "required": [
                    "type",
                    "area"
                ],
                "additionalProperties": false,
                "description": "a chart frame's area [x, y, w, h] has positive widths"
            },
            "else": {
                "type": "object",
                "properties": {
                    "type": {
                        "const": "pixel"
                    }
                },
                "required": [
                    "type"
                ],
                "additionalProperties": false
            }
        },
        "nan": {
            "type": "string",
            "description": "the meaning of a NaN value, unobserved or none",
            "enum": [
                "unobserved",
                "none"
            ]
        },
        "payload": {
            "type": "object",
            "properties": {
                "file": {
                    "type": "string",
                    "description": "a relative path inside the header's directory (the calibration manifest's rule)"
                },
                "sha256": {
                    "type": "string",
                    "description": "a SHA-256 hex digest (64 lowercase hex digits)",
                    "pattern": "^[0-9a-f]{64}$"
                }
            },
            "required": [
                "file",
                "sha256"
            ],
            "additionalProperties": false
        },
        "provenance": {
            "type": "object"
        }
    },
    "required": [
        "schema",
        "generator",
        "units",
        "conventions",
        "size",
        "element_type",
        "frame",
        "nan",
        "payload"
    ],
    "additionalProperties": false,
    "allOf": [
        {
            "if": {
                "properties": {
                    "element_type": {
                        "const": "uint8"
                    }
                }
            },
            "then": {
                "properties": {
                    "nan": {
                        "const": "none"
                    }
                }
            }
        }
    ]
}