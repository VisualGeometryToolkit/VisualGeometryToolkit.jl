{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://visualgeometrytoolkit.github.io/schemas/vgio/vignetting/v2.0.json",
    "title": "vgio/vignetting/v2.0",
    "description": "A vgio/vignetting/v2.0 file, as VisualGeometryToolkitIO writes and reads it; generated from its validator (VisualGeometryToolkitIO.json_schema). The validator is the authority: a check stated only in a `description` is the reader's. A file of a higher minor version of this major may hold keys this version does not declare: validate it against its own version's schema.",
    "type": "object",
    "properties": {
        "schema": {
            "type": "string",
            "description": "vgio/vignetting/v2.0, or the same major version at any minor",
            "pattern": "^vgio/vignetting/v2(\\.[0-9]+)?$"
        },
        "generator": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "description": "a version number"
                },
                "caller": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string",
                            "minLength": 1
                        },
                        "version": {
                            "type": "string",
                            "description": "a version number"
                        }
                    },
                    "required": [
                        "name",
                        "version"
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "name",
                "version"
            ],
            "additionalProperties": false
        },
        "units": {
            "type": "object",
            "properties": {
                "length": {
                    "type": "string",
                    "description": "a registered length unit (mm, cm, m, um, inch)",
                    "enum": [
                        "cm",
                        "ft",
                        "in",
                        "inch",
                        "km",
                        "m",
                        "mm",
                        "pt",
                        "um",
                        "μm"
                    ]
                },
                "time": {
                    "const": "s"
                },
                "angle": {
                    "const": "rad"
                },
                "pixel": {
                    "type": "string",
                    "description": "a registered pixel frame (colmap, opencv, julia)",
                    "enum": [
                        "colmap",
                        "julia",
                        "opencv"
                    ]
                },
                "density": {
                    "type": "string",
                    "description": "a registered density unit (dpi)",
                    "enum": [
                        "dpi"
                    ]
                },
                "radiance": {
                    "const": "relative"
                },
                "length_roles": {
                    "type": "object",
                    "description": "length role → its length unit, for the fields whose lengths are not in `length`",
                    "propertyNames": {
                        "pattern": "^[a-z][a-z0-9_]*$",
                        "not": {
                            "enum": [
                                "length",
                                "world",
                                "density"
                            ]
                        }
                    },
                    "additionalProperties": {
                        "type": "string",
                        "description": "a registered length unit (mm, cm, m, um, inch)",
                        "enum": [
                            "cm",
                            "ft",
                            "in",
                            "inch",
                            "km",
                            "m",
                            "mm",
                            "pt",
                            "um",
                            "μm"
                        ]
                    }
                }
            },
            "required": [
                "length",
                "time",
                "angle",
                "pixel",
                "density",
                "radiance",
                "length_roles"
            ],
            "additionalProperties": false
        },
        "conventions": {
            "type": "object",
            "properties": {
                "rotation_encoding": {
                    "const": "quaternion_wxyz_hamilton"
                },
                "transform_convention": {
                    "const": "x_to = R * x_from + t"
                },
                "matrix_layout": {
                    "const": "rows"
                },
                "grid_layout": {
                    "const": "row_major"
                },
                "index_base": {
                    "const": 1
                }
            },
            "required": [
                "rotation_encoding",
                "transform_convention",
                "matrix_layout",
                "grid_layout",
                "index_base"
            ],
            "additionalProperties": false
        },
        "vignetting": {
            "$ref": "#/$defs/vignetting"
        },
        "provenance": {
            "type": "object"
        }
    },
    "required": [
        "schema",
        "generator",
        "units",
        "conventions",
        "vignetting"
    ],
    "additionalProperties": false,
    "$defs": {
        "vignetting": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "const": "tensor_product"
                        },
                        "degree": {
                            "type": "array",
                            "items": {
                                "type": "integer",
                                "minimum": 1
                            },
                            "minItems": 2,
                            "maxItems": 2
                        },
                        "knots_x": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        "knots_y": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        "control_points": {
                            "type": "array",
                            "items": {
                                "type": "array",
                                "items": {
                                    "type": "number"
                                }
                            }
                        }
                    },
                    "required": [
                        "type",
                        "degree",
                        "knots_x",
                        "knots_y",
                        "control_points"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "const": "radial"
                        },
                        "degree": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "center": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            },
                            "minItems": 2,
                            "maxItems": 2
                        },
                        "radius": {
                            "type": "number"
                        },
                        "chart": {
                            "type": "string",
                            "description": "a radial chart (linear, projective, equisolid)",
                            "enum": [
                                "linear",
                                "projective",
                                "equisolid"
                            ]
                        },
                        "control_points": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        }
                    },
                    "required": [
                        "type",
                        "degree",
                        "center",
                        "radius",
                        "chart",
                        "control_points"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "const": "log"
                        },
                        "spline": {
                            "$ref": "#/$defs/vignetting"
                        }
                    },
                    "required": [
                        "type",
                        "spline"
                    ],
                    "additionalProperties": false
                }
            ]
        }
    }
}