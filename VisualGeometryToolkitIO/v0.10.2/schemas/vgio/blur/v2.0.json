{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://visualgeometrytoolkit.github.io/schemas/vgio/blur/v2.0.json",
    "title": "vgio/blur/v2.0",
    "description": "A vgio/blur/v2.0 file, as VisualGeometryToolkitIO writes and reads it; generated from its validator (VisualGeometryToolkitIO.json_schema). The validator is the authority: a check stated only in a `description` is the reader's. A file of a higher minor version of this major may hold keys this version does not declare: validate it against its own version's schema. blur names are unique",
    "type": "object",
    "properties": {
        "schema": {
            "type": "string",
            "description": "vgio/blur/v2.0, or the same major version at any minor",
            "pattern": "^vgio/blur/v2(\\.[0-9]+)?$"
        },
        "generator": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "description": "a version number"
                },
                "caller": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string",
                            "minLength": 1
                        },
                        "version": {
                            "type": "string",
                            "description": "a version number"
                        }
                    },
                    "required": [
                        "name",
                        "version"
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "name",
                "version"
            ],
            "additionalProperties": false
        },
        "units": {
            "type": "object",
            "properties": {
                "length": {
                    "type": "string",
                    "description": "a registered length unit (mm, cm, m, um, inch)",
                    "enum": [
                        "cm",
                        "ft",
                        "in",
                        "inch",
                        "km",
                        "m",
                        "mm",
                        "pt",
                        "um",
                        "μm"
                    ]
                },
                "time": {
                    "const": "s"
                },
                "angle": {
                    "const": "rad"
                },
                "pixel": {
                    "type": "string",
                    "description": "a registered pixel frame (colmap, opencv, julia)",
                    "enum": [
                        "colmap",
                        "julia",
                        "opencv"
                    ]
                },
                "density": {
                    "type": "string",
                    "description": "a registered density unit (dpi)",
                    "enum": [
                        "dpi"
                    ]
                },
                "radiance": {
                    "const": "relative"
                },
                "length_roles": {
                    "type": "object",
                    "description": "length role → its length unit, for the fields whose lengths are not in `length`; \"chart\": a chart role, its numbers a chart's (plain)",
                    "propertyNames": {
                        "pattern": "^[a-z][a-z0-9_]*$",
                        "not": {
                            "enum": [
                                "length",
                                "world",
                                "density"
                            ]
                        }
                    },
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "type": "string",
                                "description": "a registered length unit (mm, cm, m, um, inch)",
                                "enum": [
                                    "cm",
                                    "ft",
                                    "in",
                                    "inch",
                                    "km",
                                    "m",
                                    "mm",
                                    "pt",
                                    "um",
                                    "μm"
                                ]
                            },
                            {
                                "const": "chart"
                            }
                        ]
                    }
                }
            },
            "required": [
                "length",
                "time",
                "angle",
                "pixel",
                "density",
                "radiance",
                "length_roles"
            ],
            "additionalProperties": false
        },
        "conventions": {
            "type": "object",
            "properties": {
                "rotation_encoding": {
                    "const": "quaternion_wxyz_hamilton"
                },
                "transform_convention": {
                    "const": "x_to = R * x_from + t"
                },
                "matrix_layout": {
                    "const": "rows"
                },
                "grid_layout": {
                    "const": "row_major"
                },
                "index_base": {
                    "const": 1
                }
            },
            "required": [
                "rotation_encoding",
                "transform_convention",
                "matrix_layout",
                "grid_layout",
                "index_base"
            ],
            "additionalProperties": false
        },
        "blurs": {
            "type": "array",
            "items": {
                "type": "object",
                "oneOf": [
                    {
                        "required": [
                            "pixel_frame"
                        ]
                    },
                    {
                        "required": [
                            "frame"
                        ]
                    }
                ],
                "allOf": [
                    {
                        "if": {
                            "required": [
                                "pixel_frame"
                            ]
                        },
                        "then": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "pixel_frame": {
                                    "type": "string",
                                    "description": "a registered pixel frame (colmap, opencv, julia)",
                                    "enum": [
                                        "colmap",
                                        "julia",
                                        "opencv"
                                    ]
                                },
                                "covariance": {
                                    "description": "a covariance in the storage it holds: 2 × 2 rows (symmetric), {\"diagonal\": [its diagonal]} or {\"isotropic\": λ} (λ·I); in the value's tangent order and the file's units",
                                    "oneOf": [
                                        {
                                            "type": "array",
                                            "items": {
                                                "type": "array",
                                                "items": {
                                                    "type": "number"
                                                },
                                                "minItems": 2,
                                                "maxItems": 2
                                            },
                                            "minItems": 2,
                                            "maxItems": 2
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "diagonal": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "number"
                                                    },
                                                    "minItems": 2,
                                                    "maxItems": 2
                                                }
                                            },
                                            "required": [
                                                "diagonal"
                                            ],
                                            "additionalProperties": false
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "isotropic": {
                                                    "type": "number"
                                                }
                                            },
                                            "required": [
                                                "isotropic"
                                            ],
                                            "additionalProperties": false
                                        }
                                    ]
                                }
                            },
                            "required": [
                                "name",
                                "pixel_frame",
                                "covariance"
                            ],
                            "additionalProperties": false
                        }
                    },
                    {
                        "if": {
                            "required": [
                                "frame"
                            ]
                        },
                        "then": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "frame": {
                                    "type": "string",
                                    "description": "a blur's plane (\"target:<id>\", \"image:<id>\")",
                                    "pattern": "^(image|target):.+$"
                                },
                                "covariance": {
                                    "description": "a covariance in the storage it holds: 2 × 2 rows (symmetric), {\"diagonal\": [its diagonal]} or {\"isotropic\": λ} (λ·I); in the value's tangent order and the file's units",
                                    "oneOf": [
                                        {
                                            "type": "array",
                                            "items": {
                                                "type": "array",
                                                "items": {
                                                    "type": "number"
                                                },
                                                "minItems": 2,
                                                "maxItems": 2
                                            },
                                            "minItems": 2,
                                            "maxItems": 2
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "diagonal": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "number"
                                                    },
                                                    "minItems": 2,
                                                    "maxItems": 2
                                                }
                                            },
                                            "required": [
                                                "diagonal"
                                            ],
                                            "additionalProperties": false
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "isotropic": {
                                                    "type": "number"
                                                }
                                            },
                                            "required": [
                                                "isotropic"
                                            ],
                                            "additionalProperties": false
                                        }
                                    ]
                                }
                            },
                            "required": [
                                "name",
                                "frame",
                                "covariance"
                            ],
                            "additionalProperties": false
                        }
                    }
                ]
            }
        },
        "provenance": {
            "type": "object"
        }
    },
    "required": [
        "schema",
        "generator",
        "units",
        "conventions",
        "blurs"
    ],
    "additionalProperties": false
}